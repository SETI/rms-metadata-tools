$NOTE
##############################################################################
# Geometry file template for sun geometry.
#
#  This template controls the creation of sun geometry labels.
#
##############################################################################
$END_NOTE
$ONCE(volume_id = '_'.join(BASENAME(LABEL_PATH()).split('_')[:2]))
$ONCE(index_path = LABEL_PATH()[:-4] + '.tab')
$ONCE(table_name = BASENAME(index_path))
$ONCE(records = FILE_RECORDS(index_path))
$ONCE(record_bytes = RECORD_BYTES(index_path))
$ONCE(index_type = 'CUMULATIVE' if volume_id.endswith('999') else 'SINGLE')
PDS_VERSION_ID                  = PDS3
RECORD_TYPE                     = $LABEL_VALUE("RECORD_TYPE")$
RECORD_BYTES                    = $record_bytes$
FILE_RECORDS                    = $records$
^SUN_SUMMARY_TABLE             = "$table_name$"

$IF(index_type != 'CUMULATIVE')
VOLUME_ID                       = "$volume_id$"
$END_IF
PRODUCT_CREATION_TIME           = $FILE_TIME(index_path)$

$INCLUDE("host_defs.lbl")

OBJECT                          = SUN_SUMMARY_TABLE
  INTERCHANGE_FORMAT            = ASCII
  ROWS                          = $records$
  ROW_BYTES                     = $record_bytes$
  INDEX_TYPE                    = $index_type$
  DESCRIPTION                   = "This index describes the viewing
    geometry of the Sun for the Galileo SSI image collection. The Sun is
    treated as a target body; the file contains one row per image. Because
    the Sun is itself the source of illumination, this table omits the
    illumination-based quantities (such as phase, incidence, and sub-solar
    geometry) that appear in the body geometry table.

$IF(index_type == 'CUMULATIVE')
    This is the cumulative index, describing all the images in the collection.
$ELSE
    This index describes the images found on volume $volume_id$.
$END_IF

    Two types of geometry are represented in this index. Gridded quantities
    were constructed by uniformly sampling the pixels that comprise each data
    product on an 8x8 grid, i.e., every 64th pixel, spanning the field of
    view. Gridless quantities represent a single value.

    For each sampled pixel, a variety of geometric quantities have been
    calculated. All quantities, gridded and gridless, are tabulated in terms
    of a global minimum and maximum value with respect to the varying
    geometry during the interval in which the observation was taken. For
    angular quantities that cycle from 360 degrees to zero, the tabulated
    minimum can be numerically greater than the maximum.

    Occasionally, SPICE pointing information is unavailable for the time at
    which an observation was taken. When this situation occurs, no row has
    been added to the file.

    If the Sun is too small to have been captured in an 8x8 sampling of the
    image, or if it falls outside the field of view, then the associated
    NULL_CONSTANT will appear in the gridded columns. Quantities that are
    independent of the field of view are tabulated regardless.

    To accommodate pointing uncertainty, the Galileo SSI field of view has
    been expanded on every side by a distance equivalent to 25 narrow-angle
    pixels."

  OBJECT                        = COLUMN
    NAME                        = "VOLUME_ID"
    FORMAT                      = A7
    DESCRIPTION                 = "The unique identifier for the PDS3 data
      volume."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = "FILE_SPECIFICATION_NAME"
    FORMAT                      = A32
    DESCRIPTION                 = "The full directory path to the data file's
      label, relative to the root directory of the PDS volume."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = "SYSTEM_NAME"
    FORMAT                      = A12
    NULL_CONSTANT               = "NONE"
    DESCRIPTION                 = "The planetary system to which this body
      belongs. For the Sun this is the Sun itself."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = "BODY_NAME"
    FORMAT                      = A12
    DESCRIPTION                 = "The name of the body for which the surface
      geometry parameters in this row of the table are applicable. For this
      table the body is always the Sun."
  END_OBJECT                    = COLUMN

$INCLUDE('sun_summary_columns.lbl')

END_OBJECT                      = SUN_SUMMARY_TABLE
END
