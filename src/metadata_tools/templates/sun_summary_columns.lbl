$NOTE
##############################################################################
# Column definitions for the sun summary geometry table.
#
# The Sun is treated as a single target body. The first block of columns
# describes the surface points where pixel lines of sight intercept the Sun
# (gridded, sampled across the field of view); the second block describes
# whole-disk quantities that are independent of the field of view (gridless).
#
# Formats, units, valid ranges, and null constants mirror the entries in
# geometry_support/formats.py FORMAT_DICT for the corresponding backplane keys.
#
# Column grammar: each computed column is one COLUMN_DEFINITION object --
# holding the computation spec, the label metadata shared by the column's
# values, and the shared lead-in DESCRIPTION -- followed by one COLUMN_STUB
# object per value, holding its NAME, any keyword it overrides, and its own
# DESCRIPTION, which the write path APPENDS to the definition's (either may
# also stand alone). A single-valued column is simply a plain COLUMN carrying
# its own spec keywords. Group size is the stub count. The write path lowers
# every group to plain COLUMN objects and removes the spec keywords, so
# neither block kind nor any spec keyword ever reaches a shipped label.
#
# Spec keywords, allowed on definitions only (except OVERFLOW_FORMAT, which a
# stub may override like FORMAT):
#
#   BACKPLANE_KEY = <Python tuple literal>  the Backplane.evaluate() key; the
#                   token 'bodyx' (defs.BODYX) is substituted per body at run
#                   time, and a string 'defs.<DICT>["bodyx"]' resolves to a
#                   defs dictionary lookup after substitution
#   MASK          = ('<maskers>', '<shadowers>', '<face>'), letters P/R/M and
#                   face D/N; omitted when no mask applies
#   OVERFLOW_FORMAT = the fallback format when a value overflows the field,
#                   in PDS3 FORMAT notation
#   LINK_FN / LINK_ID = the function and group token linking columns that go
#                   null together; the id's only meaning is equality
#
# The right-hand side of BACKPLANE_KEY and MASK is a Python literal on a
# single line; nothing ever parses these lines as ODL.
##############################################################################
$END_NOTE
  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "PLANETOCENTRIC_LATITUDE"
    FORMAT                      = "F8.3"
    UNIT                        = "deg"
    VALID_MINIMUM               = -90.
    VALID_MAXIMUM               = 90.
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('latitude', 'SUN', 'centric')
    DESCRIPTION                 = "Planetocentric latitude is the angle
      between the Sun's equator plane and a vector from its center to a point
      on the surface. Values are positive in the Sun's northern hemisphere and
      negative in the southern hemisphere."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_PLANETOCENTRIC_LATITUDE
    DESCRIPTION                 = "This column tabulates the minimum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_PLANETOCENTRIC_LATITUDE
    DESCRIPTION                 = "This column tabulates the maximum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "PLANETOGRAPHIC_LATITUDE"
    FORMAT                      = "F8.3"
    UNIT                        = "deg"
    VALID_MINIMUM               = -90.
    VALID_MAXIMUM               = 90.
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('latitude', 'SUN', 'graphic')
    DESCRIPTION                 = "Planetographic latitude is the angle
      between the Sun's equator plane and the normal vector at a point on the
      surface. Values are positive in the Sun's northern hemisphere and
      negative in the southern hemisphere."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_PLANETOGRAPHIC_LATITUDE
    DESCRIPTION                 = "This column tabulates the minimum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_PLANETOGRAPHIC_LATITUDE
    DESCRIPTION                 = "This column tabulates the maximum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "IAU_LONGITUDE"
    FORMAT                      = "F8.3"
    UNIT                        = "deg"
    VALID_MINIMUM               = 0.
    VALID_MAXIMUM               = 360.
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('longitude', 'SUN', 'iau', 'west')
    DESCRIPTION                 = "IAU longitude is the angle, projected
      perpendicular to the Sun's rotation axis, from the prime meridian to a
      vector pointing from the Sun's center to a surface point. Longitudes
      increase toward the west. The prime meridian is as defined by the
      International Astronomical Union."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_IAU_LONGITUDE
    DESCRIPTION                 = "This column tabulates the easternmost
      longitude among the pixels whose lines of sight intercept the Sun's
      surface. Note that for data products that capture both sides of the
      prime meridian, this value will be numerically greater than the
      westernmost longitude."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_IAU_LONGITUDE
    DESCRIPTION                 = "This column tabulates the westernmost
      longitude among the pixels whose lines of sight intercept the Sun's
      surface. Note that for data products that capture both sides of the
      prime meridian, this value will be numerically less than the easternmost
      longitude."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "LONGITUDE_WRT_OBSERVER"
    FORMAT                      = "F8.3"
    UNIT                        = "deg"
    VALID_MINIMUM               = -180.
    VALID_MAXIMUM               = 180.
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('longitude', 'SUN', 'obs', 'west', -180)
    DESCRIPTION                 = "Longitude with respect to the observer is
      the longitude of a point on the Sun's surface minus the sub-observer
      longitude. Values are modulo 360 degrees and are shifted to the range
      -180 to 180. They increase toward the west."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_LONGITUDE_WRT_OBSERVER
    DESCRIPTION                 = "This column tabulates the minimum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_LONGITUDE_WRT_OBSERVER
    DESCRIPTION                 = "This column tabulates the maximum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "FINEST_SURFACE_RESOLUTION"
    FORMAT                      = "F10.5"
    OVERFLOW_FORMAT             = "E10.4"
    UNIT                        = "km"
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('finest_resolution', 'SUN')
    DESCRIPTION                 = "Finest surface resolution is the shorter
      dimension of a pixel as projected onto the Sun's surface at the intercept
      point. It defines the approximate size of the smallest linear feature
      that can be resolved at that surface location."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_FINEST_SURFACE_RESOLUTION
    DESCRIPTION                 = "This column tabulates the minimum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_FINEST_SURFACE_RESOLUTION
    DESCRIPTION                 = "This column tabulates the maximum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "COARSEST_SURFACE_RESOLUTION"
    FORMAT                      = "F10.5"
    OVERFLOW_FORMAT             = "E10.4"
    UNIT                        = "km"
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('coarsest_resolution', 'SUN')
    DESCRIPTION                 = "Coarsest surface resolution is the longer
      dimension of a pixel as projected onto the Sun's surface at the intercept
      point. This is larger than the finest surface resolution due to
      foreshortening by a factor of 1/cos(emission angle)."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_COARSEST_SURFACE_RESOLUTION
    DESCRIPTION                 = "This column tabulates the minimum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_COARSEST_SURFACE_RESOLUTION
    DESCRIPTION                 = "This column tabulates the maximum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "SURFACE_DISTANCE"
    FORMAT                      = "F12.3"
    OVERFLOW_FORMAT             = "E12.5"
    UNIT                        = "km"
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('distance', 'SUN')
    DESCRIPTION                 = "Surface distance is the distance between the
      observer and the intercept point on the Sun's surface."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_SURFACE_DISTANCE
    DESCRIPTION                 = "This column tabulates the minimum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_SURFACE_DISTANCE
    DESCRIPTION                 = "This column tabulates the maximum value
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "SURFACE_INTERCEPT_TIME"
    DATA_TYPE                   = TIME
    FORMAT                      = "A23"
    OVERFLOW_FORMAT             = "A23"
    NULL_CONSTANT               = "NA"
    BACKPLANE_KEY               = ('event_time', 'SUN')
    DESCRIPTION                 = "Surface intercept time is the International
      Atomic Time (TAI) when the received photon left a point on the Sun's
      surface. It is given in ISO format: YYYY-MM-DDTHH:mm:ss.sss."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_SURFACE_INTERCEPT_TIME
    DESCRIPTION                 = "This column tabulates the earliest time
      among the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_SURFACE_INTERCEPT_TIME
    DESCRIPTION                 = "This column tabulates the latest time among
      the pixels whose lines of sight intercept the Sun's surface."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "PLANETOCENTRIC_SUB_OBSERVER_LATITUDE"
    FORMAT                      = "F8.3"
    UNIT                        = "deg"
    VALID_MINIMUM               = -90.
    VALID_MAXIMUM               = 90.
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('sub_observer_latitude', 'SUN', 'centric')
    DESCRIPTION                 = "The planetocentric sub-observer point is the
      point where a photon path from the center of the Sun toward the observer
      intercepts the surface. The planetocentric latitude is the angle between
      the equator plane and a vector from the Sun's center to this point."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_PLANETOCENTRIC_SUB_OBSERVER_LATITUDE
    DESCRIPTION                 = "This column tabulates the minimum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_PLANETOCENTRIC_SUB_OBSERVER_LATITUDE
    DESCRIPTION                 = "This column tabulates the maximum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "PLANETOGRAPHIC_SUB_OBSERVER_LATITUDE"
    FORMAT                      = "F8.3"
    UNIT                        = "deg"
    VALID_MINIMUM               = -90.
    VALID_MAXIMUM               = 90.
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('sub_observer_latitude', 'SUN', 'graphic')
    DESCRIPTION                 = "The planetographic sub-observer point is the
      point on the Sun's surface where a photon toward the observer departs
      along a path parallel to the local normal vector. The planetographic
      latitude is the angle between this vector and the Sun's equatorial plane."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_PLANETOGRAPHIC_SUB_OBSERVER_LATITUDE
    DESCRIPTION                 = "This column tabulates the minimum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_PLANETOGRAPHIC_SUB_OBSERVER_LATITUDE
    DESCRIPTION                 = "This column tabulates the maximum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "SUB_OBSERVER_IAU_LONGITUDE"
    FORMAT                      = "F8.3"
    UNIT                        = "deg"
    VALID_MINIMUM               = 0.
    VALID_MAXIMUM               = 360.
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('sub_observer_longitude', 'SUN', 'iau', 'west')
    DESCRIPTION                 = "The sub-observer point is the point where a
      photon path from the center of the Sun toward the observer intercepts the
      surface. The IAU longitude is the angle, projected perpendicular to the
      Sun's rotation axis, from the prime meridian to a vector pointing from the
      center to this surface point. Longitudes increase toward the west."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_SUB_OBSERVER_IAU_LONGITUDE
    DESCRIPTION                 = "This column tabulates the easternmost value
      during the observation. It depends on the observation's timing but is
      independent of the pointing. Note that, if the sub-observer longitude
      crosses zero during the observation, this tabulated value will be
      greater than the 'maximum'."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_SUB_OBSERVER_IAU_LONGITUDE
    DESCRIPTION                 = "This column tabulates the westernmost value
      during the observation. It depends on the observation's timing but is
      independent of the pointing. Note that, if the sub-observer longitude
      crosses zero during the observation, this tabulated value will be less
      than the 'minimum'."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "CENTER_RESOLUTION"
    FORMAT                      = "F10.5"
    OVERFLOW_FORMAT             = "E10.4"
    UNIT                        = "km"
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('center_resolution', 'SUN', 'u')
    DESCRIPTION                 = "Center resolution is the linear size of a
      pixel as projected at the distance of the center of the Sun."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_CENTER_RESOLUTION
    DESCRIPTION                 = "This column tabulates the minimum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_CENTER_RESOLUTION
    DESCRIPTION                 = "This column tabulates the maximum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "CENTER_DISTANCE"
    FORMAT                      = "F12.3"
    OVERFLOW_FORMAT             = "E12.5"
    UNIT                        = "km"
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('center_distance', 'SUN', 'obs')
    DESCRIPTION                 = "Center distance is the distance from the
      observer to the center of the Sun."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_CENTER_DISTANCE
    DESCRIPTION                 = "This column tabulates the minimum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_CENTER_DISTANCE
    DESCRIPTION                 = "This column tabulates the maximum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_DEFINITION
    NAME                        = "RADIUS_IN_PIXELS"
    FORMAT                      = "F12.3"
    OVERFLOW_FORMAT             = "E12.5"
    NULL_CONSTANT               = -999.
    BACKPLANE_KEY               = ('radius_in_pixels', 'SUN')
    DESCRIPTION                 = "The apparent radius of the Sun's disk,
      converted to pixels."
  END_OBJECT                    = COLUMN_DEFINITION

  OBJECT                        = COLUMN_STUB
    NAME                        = MINIMUM_RADIUS_IN_PIXELS
    DESCRIPTION                 = "This column tabulates the minimum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN_STUB
    NAME                        = MAXIMUM_RADIUS_IN_PIXELS
    DESCRIPTION                 = "This column tabulates the maximum value
      during the observation. It depends on the observation's timing but is
      independent of the pointing."
  END_OBJECT                    = COLUMN_STUB

  OBJECT                        = COLUMN
    NAME                        = "CENTER_X_COORDINATE"
    FORMAT                      = "F12.3"
    OVERFLOW_FORMAT             = "E12.5"
    LINK_FN                     = "null"
    LINK_ID                     = "LINK-CENTER_COORDINATE"
    NULL_CONSTANT               = -99999.
    VALID_MINIMUM               = -10000.
    VALID_MAXIMUM               =  10000.
    BACKPLANE_KEY               = ('center_coordinate', 'SUN', 'x')
    DESCRIPTION                 = "Center X coordinate is the predicted
      horizontal coordinate of the center of the Sun within this data product.
      A fractional value of 0.5 indicates the center of the pixel.

      This column tabulates the mean value during the observation."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = "CENTER_Y_COORDINATE"
    FORMAT                      = "F12.3"
    OVERFLOW_FORMAT             = "E12.5"
    LINK_FN                     = "null"
    LINK_ID                     = "LINK-CENTER_COORDINATE"
    NULL_CONSTANT               = -99999.
    VALID_MINIMUM               = -10000.
    VALID_MAXIMUM               =  10000.
    BACKPLANE_KEY               = ('center_coordinate', 'SUN', 'y')
    DESCRIPTION                 = "Center Y coordinate is the predicted
      vertical coordinate of the center of the Sun within this data product.
      A fractional value of 0.5 indicates the center of the pixel.

      This column tabulates the mean value during the observation."
  END_OBJECT                    = COLUMN
